    <pages>
<!--LOC:[89:10:0:0]/nop/auth/pages/NopAuthUserSubstitution/_gen/_NopAuthUserSubstitution.view.xml
 @name=[16:21:0:0]/nop/auth/pages/NopAuthUserSubstitution/NopAuthUserSubstitution.view.xml
-->
        <crud name="main" grid="list" asideFilterForm="asideFilter" filterForm="query">
            <table autoFillHeight="true">
                <api url="@query:NopAuthUserSubstitution__findPage" gql:selection="{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:NopAuthUserSubstitution__batchDelete?ids=$ids"/>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
                <action id="add-button" level="primary" label="@i18n:common.add" icon="fa fa-plus pull-left">
                    <dialog page="add"/>
                </action>
            </listActions>
            <rowActions>
                <action id="row-view-button" level="primary" label="@i18n:common.view">
                    <dialog page="view"/>
                </action>
                <actionGroup id="row-more-button" label="@i18n:common.more" level="primary">
                    <action id="row-update-button" label="@i18n:common.edit">
                        <dialog page="update"/>
                    </action>
                    <action id="row-delete-button" label="@i18n:common.delete">
                        <api url="@mutation:NopAuthUserSubstitution__delete?id=$id"/>
                        <confirmText>@i18n:common.confirmDelete</confirmText>
                    </action>
                </actionGroup>
            </rowActions>
        </crud>
<!--LOC:[124:10:0:0]/nop/auth/pages/NopAuthUserSubstitution/_gen/_NopAuthUserSubstitution.view.xml
 @name=[17:23:0:0]/nop/auth/pages/NopAuthUserSubstitution/NopAuthUserSubstitution.view.xml
-->
        <picker name="picker" grid="pick-list" asideFilterForm="asideFilter" filterForm="query">
            <table noOperations="true">
                <api url="@query:NopAuthUserSubstitution__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </picker>
        <simple name="add" form="add">
            <api url="@mutation:NopAuthUserSubstitution__save/id"/>
        </simple>
        <simple name="view" form="view">
            <initApi url="@query:NopAuthUserSubstitution__get?id=$id" gql:selection="{@formSelection}"/>
        </simple>
        <simple name="update" form="edit">
            <initApi url="@query:NopAuthUserSubstitution__get?id=$id" gql:selection="{@formSelection}"/>
            <api url="@mutation:NopAuthUserSubstitution__update/id?id=$id" withFormData="true"/>
        </simple>
    </pages>
</view>