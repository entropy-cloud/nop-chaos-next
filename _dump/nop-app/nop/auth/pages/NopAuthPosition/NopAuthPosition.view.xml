    <pages>
<!--LOC:[72:10:0:0]/nop/auth/pages/NopAuthPosition/_gen/_NopAuthPosition.view.xml
 @name=[32:21:0:0]/nop/auth/pages/NopAuthPosition/NopAuthPosition.view.xml
