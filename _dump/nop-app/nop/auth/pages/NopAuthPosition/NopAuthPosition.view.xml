        <form id="view" editMode="view" title="查看-岗位" i18n-en:title="View Position">
            <layout>
 name[名称]
 createdBy[创建人]
 createTime[创建时间]
 updatedBy[修改人]
 updateTime[修改时间]
 remark[备注]
</layout>
        </form>
        <form id="add" editMode="add" title="新增-岗位" i18n-en:title="Add Position">
            <layout>
 name[名称]
 remark[备注]
</layout>
        </form>
        <form id="edit" editMode="edit" title="编辑-岗位" i18n-en:title="Edit Position">
