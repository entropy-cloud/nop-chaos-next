<!--LOC:[5:6:0:0]/nop/auth/pages/NopAuthExtLogin/_gen/_NopAuthExtLogin.view.xml-->
    <objMeta>/nop/auth/model/NopAuthExtLogin/NopAuthExtLogin.xmeta</objMeta>

