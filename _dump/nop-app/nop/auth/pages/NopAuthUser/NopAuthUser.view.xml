<!--LOC:[103:6:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml-->
    <forms>
<!--LOC:[104:10:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @id=[19:19:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
        <form id="view" editMode="view" title="查看-用户" i18n-en:title="View User">
            <layout>
                ===========&gt;baseInfo[基本信息]======
                userName status[用户状态]
                nickName[昵称] deptId[部门]
                avatar
                userType[用户类型] gender[性别]
                email[邮件] phone[电话]
                openId[用户外部标识]
                expireAt[用户过期时间] changePwdAtLogin[登陆后立刻修改密码]
                tenantId

                ===========&gt;extInfo[扩展信息]=========
                idType[证件类型] idNbr[证件号]
                birthday[生日] workNo[工号]
                positionId[职务] telephone[座机]
                remark[备注]
                createdBy[创建人] createTime[创建时间]
                updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>

        <!--</cells>-->
<!--LOC:[123:10:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @id=[45:19:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
        <form id="add" editMode="add" title="新增-用户" i18n-en:title="Add User" layoutControl="tabs">
            <layout>
                ============&gt;baseInfo[基本信息]======
                userName status[用户状态]
                nickName[昵称] deptId[部门]
                avatar
                userType[用户类型] gender[性别]
                password[密码] *__password2[重复密码]
                email[邮件] phone[电话]
                expireAt[用户过期时间] changePwdAtLogin[登陆后立刻修改密码]
                tenantId[租户]

                ===========^extInfo[扩展信息]=========
                idType[证件类型] idNbr[证件号]
                birthday[生日] workNo[工号]
                positionId[职务] telephone[座机]
                remark[备注]
            </layout>
<!--LOC:[64:14:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml-->
            <cells>
                <cell id="__password2" custom="true" label="重复密码">
                    <gen-control>
                        <input-password>
                            <validations equalsField="password"/>
                        </input-password>
                    </gen-control>
                </cell>
                <cell id="tenantId" mandatory="false"/>
            </cells>
        </form>
<!--LOC:[123:10:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @id=[76:19:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
        <form id="edit" editMode="edit" title="编辑-用户" i18n-en:title="Edit User" layoutControl="tabs">
            <layout>
                ============&gt;baseInfo[基本信息]======
                userName status[用户状态]
                nickName[昵称] deptId[部门]
                avatar
                userType[用户类型] gender[性别]
                email[邮件] phone[电话]
                expireAt[用户过期时间] changePwdAtLogin[登陆后立刻修改密码]

                ===========^extInfo[扩展信息]=========
                idType[证件类型] idNbr[证件号]
                birthday[生日] workNo[工号]
                positionId[职务] telephone[座机]
                remark[备注]
            </layout>
        </form>
<!--LOC:[138:10:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @id=[94:19:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
<!--LOC:[95:14:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml-->
            <layout>
                userName gender status
                nickName phone
            </layout>
        </form>
<!--LOC:[139:10:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @id=[101:19:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
        <form id="asideFilter" editMode="query" submitOnChange="true">
<!--LOC:[102:14:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml-->
            <layout>
                ==dept[部门]==
                !deptId
            </layout>
            <cells>
                <cell id="deptId">
                    <gen-control>
                        <input-tree
                                    source="@query:NopAuthDept__findList/value:id,label:deptName,children @TreeChildren(max:5)?filter_parentId=__null"/>
                    </gen-control>
                </cell>
            </cells>
        </form>
        <form id="changeSelfPassword">
            <layout>
                @userName
                oldPassword
                newPassword
            </layout>
            <cells>
                <cell id="oldPassword" control="password" custom="true"/>
                <cell id="newPassword" control="password" custom="true"/>
            </cells>
        </form>
        <form id="resetUserPassword" title="@i18n:common.resetUserPassword" size="md" editMode="edit">
            <layout>
                @userName
                password
            </layout>
            <cells>
                <cell id="password" control="password" custom="true"/>
            </cells>
        </form>
    </forms>

<!--LOC:[143:6:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml-->
    <pages>
<!--LOC:[149:10:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @name=[141:21:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
        <crud name="main" grid="list" asideFilterForm="asideFilter" filterForm="query">
            <table autoFillHeight="true">
                <api url="@query:NopAuthUser__findPage" gql:selection="{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:NopAuthUser__batchDelete?ids=$ids"/>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
                <action id="add-button" level="primary" label="@i18n:common.add" icon="fa fa-plus pull-left">
                    <dialog page="add"/>
                </action>
            </listActions>
<!--LOC:[142:14:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml-->
            <autoGenerateFilter columnsNum="2"/>
<!--LOC:[162:14:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml-->
            <rowActions>
                <action id="row-view-button" level="primary" label="@i18n:common.view">
                    <dialog page="view"/>
                </action>
<!--LOC:[173:18:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @id=[145:34:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
                <actionGroup id="row-more-button" label="@i18n:common.more" level="primary">
                    <action id="row-update-button" label="@i18n:common.edit">
                        <dialog page="update"/>
                    </action>
                    <action id="row-delete-button" label="@i18n:common.delete">
                        <api url="@mutation:NopAuthUser__delete?id=$id"/>
                        <confirmText>@i18n:common.confirmDelete</confirmText>
                    </action>
<!--LOC:[146:22:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml-->
                    <action id="reset-password-button" label="@i18n:common.resetUserPassword">
                        <dialog page="resetUserPassword"/>
                    </action>
                    <action id="disable-user-button" label="@i18n:common.disableUser">
                        <confirmText>@i18n:common.confirmDisableUser</confirmText>
                        <api url="@mutation:NopAuthUser__disableUser">
                            <data>
                                <userId>${'$'}{id}</userId>
                            </data>
                        </api>
                        <visibleOn>${status == 1}</visibleOn>
                    </action>
                    <action id="enable-user-button" label="@i18n:common.enableUser">
                        <confirmText>@i18n:common.confirmEnableUser</confirmText>
                        <api url="@mutation:NopAuthUser__enableUser">
                            <data>
                                <userId>${'$'}{id}</userId>
                            </data>
                        </api>
                        <visibleOn>${status == 0}</visibleOn>
                    </action>
                </actionGroup>
            </rowActions>
        </crud>
<!--LOC:[184:10:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @name=[171:23:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
        <picker name="picker" grid="pick-list" asideFilterForm="asideFilter" filterForm="query">
            <table noOperations="true">
<!--LOC:[186:18:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml
 @url=[173:27:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml
-->
                <api url="@query:NopAuthUser__active_findPage" gql:selection="{@pageSelection}"/>
            </table>
        </picker>
<!--LOC:[177:10:0:0]/nop/auth/pages/NopAuthUser/NopAuthUser.view.xml-->
        <crud name="deleted" grid="list">
            <table>
                <api url="@query:NopAuthUser__deleted_findPage/{@pageSelection}"/>
            </table>
            <rowActions>
                <action id="recover-deleted-button" label="@i18n:common.recoverDeleted">
                    <api url="@mutation:NopAuthUser__recoverDeleted/id">
                        <data>
                            <id>${'$'}{id}</id>
                        </data>
                    </api>
                    <confirmText>@i18n:common.confirmRecoverDeleted</confirmText>
                </action>
            </rowActions>
        </crud>
        <simple name="resetUserPassword" form="resetUserPassword">
            <api url="@mutation:NopAuthUser__resetUserPassword?userId=${'$'}{id}">
                <data>
                    <password>${'$'}{password}</password>
                </data>
            </api>
        </simple>
        <crud name="role-users" grid="simple-list">
            <table loadDataOnce="true" name="role-users-grid">
                <api url="@query:NopAuthRole__get/items:roleUsers{{@listSelection!}}?id=${'$'}{roleId}"/>
            </table>
            <listActions>
                <action id="select-user-button" label="@i18n:common.selectUser">
                    <dialog page="select-role-users" size="md" noActions="true"/>
                </action>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:NopAuthRole__removeRoleUsers">
                        <data>
                            <roleId>${'$'}{roleId}</roleId>
                            <userIds>${'$'}{ids}</userIds>
                        </data>
                    </api>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
            </listActions>
        </crud>
        <crud name="select-role-users" grid="pick-list" title="@i18n:common.selectUser">
            <table pickerMode="true" multiple="true" noOperations="true">
                <api url="@query:NopAuthUser__active_findPage/{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-add-user-button" label="@i18n:common.submit" level="primary" batch="true"
                        close="select-role-users" reload="role-users-grid">
                    <api url="@mutation:NopAuthRole__addRoleUsers">
                        <data>
                            <roleId>${'$'}{roleId}</roleId>
                            <userIds>${'$'}{ids}</userIds>
                        </data>
                    </api>
                </action>
            </listActions>
        </crud>
<!--LOC:[189:10:0:0]/nop/auth/pages/NopAuthUser/_gen/_NopAuthUser.view.xml-->
        <simple name="add" form="add">
            <api url="@mutation:NopAuthUser__save/id"/>
        </simple>
        <simple name="view" form="view">
            <initApi url="@query:NopAuthUser__get?id=$id" gql:selection="{@formSelection}"/>
        </simple>
        <simple name="update" form="edit">
            <initApi url="@query:NopAuthUser__get?id=$id" gql:selection="{@formSelection}"/>
            <api url="@mutation:NopAuthUser__update/id?id=$id" withFormData="true"/>
        </simple>
    </pages>
</view>