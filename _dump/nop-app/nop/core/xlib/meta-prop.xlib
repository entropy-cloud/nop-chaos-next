<?xml version="1.0" encoding="UTF-8" ?>
<lib xmlns:x="/nop/schema/xdsl.xdef" x:validated="true" x:schema="/nop/schema/xlib.xdef">

    <tags>
        <domain-csv-list outputMode="node">
            <attr name="propNode"/>
            <source>
                <prop name="${propNode.getAttr('name')}">
                    <schema type="List&lt;String&gt;"/>
                    <transformIn>
                        return value?.$toCsvListString();
                    </transformIn>
                    <transformOut>
                        return value?.$toCsvList();
                    </transformOut>
                </prop>
            </source>
        </domain-csv-list>
        <domain-file-list outputMode="node">
            <attr name="propNode"/>
            <source>
                <prop name="${propNode.getAttr('name')}">
                    <schema type="List&lt;String&gt;"/>
                    <transformIn>
                        import io.nop.orm.support.OrmEntityHelper;
                        return OrmEntityHelper.joinFileList(value?.$toCsvList());
                    </transformIn>
                    <transformOut>
                        import io.nop.orm.support.OrmEntityHelper;
                        return OrmEntityHelper.parseFileList(value);
                    </transformOut>
                </prop>
            </source>
        </domain-file-list>
        <domain-images outputMode="node">
            <attr name="propNode"/>
            <source>
                <prop name="${propNode.getAttr('name')}">
                    <schema type="List&lt;String&gt;"/>
                    <transformIn>
                        import io.nop.orm.support.OrmEntityHelper;
                        return OrmEntityHelper.joinFileList(value?.$toCsvList());
                    </transformIn>
                    <transformOut>
                        import io.nop.orm.support.OrmEntityHelper;
                        return OrmEntityHelper.parseFileList(value);
                    </transformOut>
                </prop>
            </source>
        </domain-images>
    </tags>
</lib>