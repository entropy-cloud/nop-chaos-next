        <!--
            mysql不支持decode函数
            <native name="decode" minArgCount="3" maxArgCount="100" argTypes="ANY,ANY,ANY">
            <description>
            DECODE(value, whenValue, thenValue [,...])
            Returns the first matching value. NULL is considered to match NULL. If no
