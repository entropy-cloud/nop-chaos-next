<view bizObjName="NopSysNoticeTemplate" xmlns:i18n-en="i18n-en" xmlns:x="/nop/schema/xdsl.xdef" xmlns:j="j" xmlns:c="c"
      xmlns:gql="gql" xmlns:view-gen="view-gen" xmlns:xpl="xpl" x:validated="true" x:schema="/nop/schema/xui/xview.xdef">

<!--LOC:[5:6:0:0]/nop/sys/pages/NopSysNoticeTemplate/_gen/_NopSysNoticeTemplate.view.xml-->
    <objMeta>/nop/sys/model/NopSysNoticeTemplate/NopSysNoticeTemplate.xmeta</objMeta>

    <controlLib>/nop/web/xlib/control.xlib</controlLib>

    <grids>
<!--LOC:[18:10:0:0]/nop/sys/pages/NopSysNoticeTemplate/_gen/_NopSysNoticeTemplate.view.xml
 @id=[6:19:0:0]/nop/sys/pages/NopSysNoticeTemplate/NopSysNoticeTemplate.view.xml
-->
        <grid id="list">
            <cols>

                <!--主键-->
                <col id="sid" mandatory="true" sortable="true"/>

                <!--名称-->
                <col id="name" mandatory="true" sortable="true"/>

                <!--模板类型-->
                <col id="tplType" mandatory="true" sortable="true"/>

                <!--模板内容-->
                <col id="content" mandatory="true" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>

                <!--备注-->
                <col id="remark" sortable="true"/>
            </cols>
        </grid>
<!--LOC:[18:10:0:0]/nop/sys/pages/NopSysNoticeTemplate/_gen/_NopSysNoticeTemplate.view.xml
 @id=[7:19:0:0]/nop/sys/pages/NopSysNoticeTemplate/NopSysNoticeTemplate.view.xml
-->
        <grid id="pick-list">
            <cols>

                <!--主键-->
                <col id="sid" mandatory="true" sortable="true"/>

                <!--名称-->
                <col id="name" mandatory="true" sortable="true"/>

                <!--模板类型-->
                <col id="tplType" mandatory="true" sortable="true"/>

                <!--模板内容-->
                <col id="content" mandatory="true" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>

                <!--备注-->
                <col id="remark" sortable="true"/>
            </cols>
        </grid>
    </grids>

    <forms>
<!--LOC:[53:10:0:0]/nop/sys/pages/NopSysNoticeTemplate/_gen/_NopSysNoticeTemplate.view.xml
 @id=[11:19:0:0]/nop/sys/pages/NopSysNoticeTemplate/NopSysNoticeTemplate.view.xml
-->
        <form id="view" editMode="view" title="查看-通知模板" i18n-en:title="View Notice Template">
            <layout>
 sid[主键]
 name[名称]
 tplType[模板类型]
 content[模板内容]
 createdBy[创建人]
 createTime[创建时间]
 updatedBy[修改人]
 updateTime[修改时间]
 remark[备注]
</layout>
        </form>
<!--LOC:[67:10:0:0]/nop/sys/pages/NopSysNoticeTemplate/_gen/_NopSysNoticeTemplate.view.xml
 @id=[12:19:0:0]/nop/sys/pages/NopSysNoticeTemplate/NopSysNoticeTemplate.view.xml
-->
        <form id="edit" editMode="edit" title="编辑-通知模板" i18n-en:title="Edit Notice Template">
            <layout>
 sid[主键]
 name[名称]
 tplType[模板类型]
 content[模板内容]
 remark[备注]
</layout>
        </form>
<!--LOC:[67:10:0:0]/nop/sys/pages/NopSysNoticeTemplate/_gen/_NopSysNoticeTemplate.view.xml
 @id=[13:19:0:0]/nop/sys/pages/NopSysNoticeTemplate/NopSysNoticeTemplate.view.xml
-->
        <form id="add" editMode="add" title="新增-通知模板" i18n-en:title="Add Notice Template">
            <layout>
 sid[主键]
 name[名称]
 tplType[模板类型]
 content[模板内容]
 remark[备注]
</layout>
        </form>
    </forms>

    <pages>
<!--LOC:[87:10:0:0]/nop/sys/pages/NopSysNoticeTemplate/_gen/_NopSysNoticeTemplate.view.xml
 @name=[17:21:0:0]/nop/sys/pages/NopSysNoticeTemplate/NopSysNoticeTemplate.view.xml
-->
        <crud name="main" grid="list" asideFilterForm="asideFilter" filterForm="query">
            <table autoFillHeight="true">
                <api url="@query:NopSysNoticeTemplate__findPage" gql:selection="{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:NopSysNoticeTemplate__batchDelete?ids=$ids"/>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
                <action id="add-button" level="primary" label="@i18n:common.add" icon="fa fa-plus pull-left">
                    <dialog page="add"/>
                </action>
            </listActions>
            <rowActions>
                <action id="row-view-button" level="primary" label="@i18n:common.view">
                    <dialog page="view"/>
                </action>
                <actionGroup id="row-more-button" label="@i18n:common.more" level="primary">
                    <action id="row-update-button" label="@i18n:common.edit">
                        <dialog page="update"/>
                    </action>
                    <action id="row-delete-button" label="@i18n:common.delete">
                        <api url="@mutation:NopSysNoticeTemplate__delete?id=$id"/>
                        <confirmText>@i18n:common.confirmDelete</confirmText>
                    </action>
                </actionGroup>
            </rowActions>
        </crud>
<!--LOC:[122:10:0:0]/nop/sys/pages/NopSysNoticeTemplate/_gen/_NopSysNoticeTemplate.view.xml
 @name=[18:23:0:0]/nop/sys/pages/NopSysNoticeTemplate/NopSysNoticeTemplate.view.xml
-->
        <picker name="picker" grid="pick-list" asideFilterForm="asideFilter" filterForm="query">
            <table noOperations="true">
                <api url="@query:NopSysNoticeTemplate__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </picker>
        <simple name="add" form="add">
            <api url="@mutation:NopSysNoticeTemplate__save/id"/>
        </simple>
        <simple name="view" form="view">
            <initApi url="@query:NopSysNoticeTemplate__get?id=$id" gql:selection="{@formSelection}"/>
        </simple>
        <simple name="update" form="edit">
            <initApi url="@query:NopSysNoticeTemplate__get?id=$id" gql:selection="{@formSelection}"/>
            <api url="@mutation:NopSysNoticeTemplate__update/id?id=$id" withFormData="true"/>
        </simple>
    </pages>
</view>