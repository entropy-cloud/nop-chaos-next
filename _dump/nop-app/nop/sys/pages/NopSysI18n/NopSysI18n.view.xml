-->
<view bizObjName="NopSysI18n" xmlns:i18n-en="i18n-en" xmlns:x="/nop/schema/xdsl.xdef" xmlns:j="j" xmlns:c="c"
      xmlns:gql="gql" xmlns:view-gen="view-gen" xmlns:xpl="xpl" x:validated="true" x:schema="/nop/schema/xui/xview.xdef">

<!--LOC:[5:6:0:0]/nop/sys/pages/NopSysI18n/_gen/_NopSysI18n.view.xml-->
    <objMeta>/nop/sys/model/NopSysI18n/NopSysI18n.xmeta</objMeta>

    <controlLib>/nop/web/xlib/control.xlib</controlLib>

    <grids>
<!--LOC:[18:10:0:0]/nop/sys/pages/NopSysI18n/_gen/_NopSysI18n.view.xml
 @id=[5:19:0:0]/nop/sys/pages/NopSysI18n/NopSysI18n.view.xml
-->
        <grid id="list">
            <cols>

                <!--字符串Key-->
                <col id="i18nKey" mandatory="true" sortable="true"/>

                <!--语言-->
                <col id="i18nLocale" mandatory="true" sortable="true"/>

                <!--值-->
                <col id="value" mandatory="true" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>

                <!--备注-->
                <col id="remark" sortable="true"/>
            </cols>
        </grid>
<!--LOC:[18:10:0:0]/nop/sys/pages/NopSysI18n/_gen/_NopSysI18n.view.xml
 @id=[6:19:0:0]/nop/sys/pages/NopSysI18n/NopSysI18n.view.xml
-->
        <grid id="pick-list">
            <cols>

                <!--字符串Key-->
                <col id="i18nKey" mandatory="true" sortable="true"/>

                <!--语言-->
                <col id="i18nLocale" mandatory="true" sortable="true"/>

                <!--值-->
                <col id="value" mandatory="true" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>

                <!--备注-->
                <col id="remark" sortable="true"/>
            </cols>
        </grid>
    </grids>

    <forms>
<!--LOC:[50:10:0:0]/nop/sys/pages/NopSysI18n/_gen/_NopSysI18n.view.xml
 @id=[10:19:0:0]/nop/sys/pages/NopSysI18n/NopSysI18n.view.xml
-->
        <form id="view" editMode="view" title="查看-多语言消息" i18n-en:title="View I18n Message">
            <layout>
 i18nKey[字符串Key]
 i18nLocale[语言]
 value[值]
 createdBy[创建人]
 createTime[创建时间]
 updatedBy[修改人]
 updateTime[修改时间]
 remark[备注]
</layout>
        </form>
<!--LOC:[63:10:0:0]/nop/sys/pages/NopSysI18n/_gen/_NopSysI18n.view.xml
 @id=[11:19:0:0]/nop/sys/pages/NopSysI18n/NopSysI18n.view.xml
-->
        <form id="edit" editMode="edit" title="编辑-多语言消息" i18n-en:title="Edit I18n Message">
            <layout>
 i18nKey[字符串Key]
 i18nLocale[语言]
 value[值]
 remark[备注]
</layout>
        </form>
<!--LOC:[63:10:0:0]/nop/sys/pages/NopSysI18n/_gen/_NopSysI18n.view.xml
 @id=[12:19:0:0]/nop/sys/pages/NopSysI18n/NopSysI18n.view.xml
-->
        <form id="add" editMode="add" title="新增-多语言消息" i18n-en:title="Add I18n Message">
            <layout>
 i18nKey[字符串Key]
 i18nLocale[语言]
 value[值]
 remark[备注]
</layout>
        </form>
    </forms>

    <pages>
<!--LOC:[82:10:0:0]/nop/sys/pages/NopSysI18n/_gen/_NopSysI18n.view.xml
 @name=[16:21:0:0]/nop/sys/pages/NopSysI18n/NopSysI18n.view.xml
-->
        <crud name="main" grid="list" asideFilterForm="asideFilter" filterForm="query">
            <table autoFillHeight="true">
                <api url="@query:NopSysI18n__findPage" gql:selection="{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:NopSysI18n__batchDelete?ids=$ids"/>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
                <action id="add-button" level="primary" label="@i18n:common.add" icon="fa fa-plus pull-left">
                    <dialog page="add"/>
                </action>
            </listActions>
            <rowActions>
                <action id="row-view-button" level="primary" label="@i18n:common.view">
                    <dialog page="view"/>
                </action>
                <actionGroup id="row-more-button" label="@i18n:common.more" level="primary">
                    <action id="row-update-button" label="@i18n:common.edit">
                        <dialog page="update"/>
                    </action>
                    <action id="row-delete-button" label="@i18n:common.delete">
                        <api url="@mutation:NopSysI18n__delete?id=$id"/>
                        <confirmText>@i18n:common.confirmDelete</confirmText>
                    </action>
                </actionGroup>
            </rowActions>
        </crud>
<!--LOC:[117:10:0:0]/nop/sys/pages/NopSysI18n/_gen/_NopSysI18n.view.xml
 @name=[17:23:0:0]/nop/sys/pages/NopSysI18n/NopSysI18n.view.xml
-->
        <picker name="picker" grid="pick-list" asideFilterForm="asideFilter" filterForm="query">
            <table noOperations="true">
                <api url="@query:NopSysI18n__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </picker>
        <simple name="add" form="add">
            <api url="@mutation:NopSysI18n__save/id"/>
        </simple>
        <simple name="view" form="view">
            <initApi url="@query:NopSysI18n__get?id=$id" gql:selection="{@formSelection}"/>
        </simple>
        <simple name="update" form="edit">
            <initApi url="@query:NopSysI18n__get?id=$id" gql:selection="{@formSelection}"/>
            <api url="@mutation:NopSysI18n__update/id?id=$id" withFormData="true"/>
        </simple>
    </pages>
</view>