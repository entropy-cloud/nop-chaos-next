<view bizObjName="NopSysDict" xmlns:i18n-en="i18n-en" xmlns:x="/nop/schema/xdsl.xdef" xmlns:j="j" xmlns:c="c"
      xmlns:gql="gql" xmlns:view-gen="view-gen" xmlns:xpl="xpl" x:validated="true" x:schema="/nop/schema/xui/xview.xdef">

<!--LOC:[5:6:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml-->
    <objMeta>/nop/sys/model/NopSysDict/NopSysDict.xmeta</objMeta>

    <controlLib>/nop/web/xlib/control.xlib</controlLib>

    <grids>
<!--LOC:[18:10:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml
 @id=[5:19:0:0]/nop/sys/pages/NopSysDict/NopSysDict.view.xml
-->
        <grid id="list">
            <cols>

                <!--字典名-->
                <col id="dictName" mandatory="true" sortable="true"/>

                <!--显示名-->
                <col id="displayName" mandatory="true" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>

                <!--备注-->
                <col id="remark" sortable="true"/>
            </cols>
        </grid>
<!--LOC:[18:10:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml
 @id=[6:19:0:0]/nop/sys/pages/NopSysDict/NopSysDict.view.xml
-->
        <grid id="pick-list">
            <cols>

                <!--字典名-->
                <col id="dictName" mandatory="true" sortable="true"/>

                <!--显示名-->
                <col id="displayName" mandatory="true" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>

                <!--备注-->
                <col id="remark" sortable="true"/>
            </cols>
        </grid>
    </grids>

    <forms>
<!--LOC:[47:10:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml
 @id=[10:19:0:0]/nop/sys/pages/NopSysDict/NopSysDict.view.xml
-->
        <form id="view" editMode="view" title="查看-字典表" i18n-en:title="View Dictionary">
            <layout>
 dictName[字典名]
 displayName[显示名]
 createdBy[创建人]
 createTime[创建时间]
 updatedBy[修改人]
 updateTime[修改时间]
 remark[备注]
</layout>
        </form>
<!--LOC:[59:10:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml
 @id=[11:19:0:0]/nop/sys/pages/NopSysDict/NopSysDict.view.xml
-->
        <form id="edit" editMode="edit" title="编辑-字典表" i18n-en:title="Edit Dictionary">
            <layout>
 dictName[字典名]
 displayName[显示名]
 remark[备注]
</layout>
        </form>
<!--LOC:[59:10:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml
 @id=[12:19:0:0]/nop/sys/pages/NopSysDict/NopSysDict.view.xml
-->
        <form id="add" editMode="add" title="新增-字典表" i18n-en:title="Add Dictionary">
            <layout>
 dictName[字典名]
 displayName[显示名]
 remark[备注]
</layout>
        </form>
    </forms>

    <pages>
<!--LOC:[77:10:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml
 @name=[16:21:0:0]/nop/sys/pages/NopSysDict/NopSysDict.view.xml
-->
        <crud name="main" grid="list" asideFilterForm="asideFilter" filterForm="query">
            <table autoFillHeight="true">
                <api url="@query:NopSysDict__findPage" gql:selection="{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:NopSysDict__batchDelete?ids=$ids"/>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
                <action id="add-button" level="primary" label="@i18n:common.add" icon="fa fa-plus pull-left">
                    <dialog page="add"/>
                </action>
            </listActions>
            <rowActions>
<!--LOC:[20:18:0:0]/nop/sys/pages/NopSysDict/NopSysDict.view.xml-->
                <action id="items-button" label="条目" level="primary" actionType="drawer">
                    <dialog page="/nop/sys/pages/NopSysDictOption/dict-ref.page.yaml" size="lg">
                        <data>
                            <dictId>${'$'}{id}</dictId>
                            <dictName>${'$'}{displayName}</dictName>
                        </data>
                    </dialog>
                </action>
<!--LOC:[101:18:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml-->
                <actionGroup id="row-more-button" label="@i18n:common.more" level="primary">
                    <action id="row-update-button" label="@i18n:common.edit">
                        <dialog page="update"/>
                    </action>
                    <action id="row-delete-button" label="@i18n:common.delete">
                        <api url="@mutation:NopSysDict__delete?id=$id"/>
                        <confirmText>@i18n:common.confirmDelete</confirmText>
                    </action>
                </actionGroup>
            </rowActions>
        </crud>
<!--LOC:[112:10:0:0]/nop/sys/pages/NopSysDict/_gen/_NopSysDict.view.xml
 @name=[31:23:0:0]/nop/sys/pages/NopSysDict/NopSysDict.view.xml
-->
        <picker name="picker" grid="pick-list" asideFilterForm="asideFilter" filterForm="query">
            <table noOperations="true">
                <api url="@query:NopSysDict__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </picker>
        <simple name="add" form="add">
            <api url="@mutation:NopSysDict__save/id"/>
        </simple>
        <simple name="view" form="view">
            <initApi url="@query:NopSysDict__get?id=$id" gql:selection="{@formSelection}"/>
        </simple>
        <simple name="update" form="edit">
            <initApi url="@query:NopSysDict__get?id=$id" gql:selection="{@formSelection}"/>
            <api url="@mutation:NopSysDict__update/id?id=$id" withFormData="true"/>
        </simple>
    </pages>
</view>