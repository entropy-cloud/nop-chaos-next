<?xml version="1.0" encoding="UTF-8" ?>
<registry xmlns:x="/nop/schema/xdsl.xdef" x:validated="true" x:schema="/nop/schema/registry.xdef">

    <models>
<!--LOC:[1:2:0:0]/nop/core/registry/api.register-model.xml-->
        <model name="api">
            <loaders>
                <xlsx-loader fileType="api.xlsx" impPath="/nop/rpc/imp/api.imp.xml"/>
                <xdsl-loader fileType="api.xml" schemaPath="/nop/schema/api.xdef"/>
