            </loaders>
        </model>
<!--LOC:[1:2:0:0]/nop/core/registry/orm.register-model.xml-->
        <model name="orm">
            <loaders>
                <xdsl-loader fileType="orm.xml" schemaPath="/nop/schema/orm/orm.xdef"/>
