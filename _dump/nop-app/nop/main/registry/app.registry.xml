<!--LOC:[1:2:0:0]/nop/core/registry/xtask.register-model.xml-->
        <model name="xtask">
            <loaders>
                <loader fileType="xtask" class="io.nop.xlang.xpl.impl.XplTaskLoader"/>
            </loaders>
        </model>
    </models>
</registry>