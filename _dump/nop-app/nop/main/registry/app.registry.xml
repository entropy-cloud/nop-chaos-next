        </model>
<!--LOC:[1:2:0:0]/nop/core/registry/dialect.register-model.xml-->
        <model name="dialect">
            <loaders>
                <loader fileType="dialect.xml" class="io.nop.dao.dialect.loader.DialectModelLoader"/>
            </loaders>
        </model>
<!--LOC:[1:2:0:0]/nop/core/registry/dict.register-model.xml-->
        <model name="dict">
            <loaders>
                <xdsl-loader fileType="dict.xml" schemaPath="/nop/schema/orm/dict.xdef"/>
                <xdsl-loader fileType="dict.yaml" schemaPath="/nop/schema/orm/dict.xdef"/>
            </loaders>
        </model>
<!--LOC:[1:2:0:0]/nop/core/registry/fsm.register-model.xml-->
        <model name="state-machine">
            <loaders>
                <xdsl-loader fileType="fsm.xml" schemaPath="/nop/schema/biz/state-machine.xdef"/>
            </loaders>
        </model>
<!--LOC:[1:2:0:0]/nop/core/registry/js.register-model.xml-->
        <model name="js">
            <loaders>
                <loader fileType="js" class="io.nop.web.page.DynamicJsModelLoader"/>
