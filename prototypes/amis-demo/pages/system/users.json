{
  "x:extends": "../_partials/crud-page.json",
  "title": "用户管理",
  "body": {
    "api": {
      "method": "get",
      "url": "/api/mock/users"
    },
    "headerToolbar": [
      {
        "type": "button",
        "label": "新增用户",
        "level": "primary",
        "actionType": "dialog",
        "dialog": {
          "title": "新增用户",
          "body": {
            "type": "form",
            "api": {
              "method": "post",
              "url": "/api/mock/users"
            },
            "body": [
              {
                "type": "input-text",
                "name": "name",
                "label": "姓名",
                "required": true
              },
              {
                "type": "input-email",
                "name": "email",
                "label": "邮箱",
                "required": true
              },
              {
                "type": "select",
                "name": "role",
                "label": "角色",
                "options": ["admin", "editor", "viewer"],
                "value": "viewer"
              },
              {
                "type": "select",
                "name": "status",
                "label": "状态",
                "options": ["active", "disabled"],
                "value": "active"
              }
            ]
          }
        }
      }
    ],
    "columns": [
      { "name": "id", "label": "ID", "width": 60 },
      { "name": "name", "label": "姓名" },
      { "name": "email", "label": "邮箱" },
      { "name": "role", "label": "角色" },
      {
        "name": "status",
        "label": "状态",
        "type": "mapping",
        "map": {
          "active": "<span class='label label-success'>启用</span>",
          "disabled": "<span class='label label-danger'>禁用</span>"
        }
      },
      {
        "type": "operation",
        "label": "操作",
        "buttons": [
          {
            "type": "button",
            "label": "编辑",
            "level": "link",
            "actionType": "dialog",
            "dialog": {
              "title": "编辑用户",
              "body": {
                "type": "form",
                "api": {
                  "method": "put",
                  "url": "/api/mock/users/${id}"
                },
                "body": [
                  {
                    "type": "input-text",
                    "name": "name",
                    "label": "姓名",
                    "required": true
                  },
                  {
                    "type": "input-email",
                    "name": "email",
                    "label": "邮箱",
                    "required": true
                  },
                  {
                    "type": "select",
                    "name": "role",
                    "label": "角色",
                    "options": ["admin", "editor", "viewer"]
                  },
                  {
                    "type": "select",
                    "name": "status",
                    "label": "状态",
                    "options": ["active", "disabled"]
                  }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "删除",
            "level": "link",
            "confirmText": "确认删除该用户？",
            "actionType": "ajax",
            "api": {
              "method": "delete",
              "url": "/api/mock/users/${id}"
            }
          }
        ]
      }
    ]
  }
}
