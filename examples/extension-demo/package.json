{
  "name": "@nop-chaos/example-extension-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:standalone": "vite --config vite.standalone.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && node ../../packages/extension-dev/src/cli.mjs build --root . --id example-extension-demo --name \"Harbor Operations Suite\" --version 0.0.1 --entry src/index.ts --out dist",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@nop-chaos/extension-dev": "workspace:*",
    "@nop-chaos/plugin-bridge": "workspace:*",
    "@nop-chaos/shared": "workspace:*",
    "@nop-chaos/tailwind-preset": "workspace:*",
    "@nop-chaos/theme-tokens": "workspace:*",
    "@nop-chaos/ui": "workspace:*",
    "@vitejs/plugin-react": "^6.0.1",
    "lucide-react": "^1.7.0",
    "react-router-dom": "^7.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "peerDependencies": {
    "@nop-chaos/plugin-bridge": "workspace:*",
    "@nop-chaos/shared": "workspace:*",
    "lucide-react": "^1.7.0",
    "@nop-chaos/ui": "workspace:*",
    "react": "^19.0.0"
  }
}
